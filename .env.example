# ============================================================
# Product Inventory & Analytics Service — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# Server
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/inventory_db
DB_USERNAME=postgres
DB_PASSWORD=change_me

# JWT
# Must be at least 256 bits (32+ characters). Use a strong random value.
JWT_SECRET=change-this-secret-key-in-production-must-be-at-least-256-bits
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Provider (provider-agnostic — set these to whatever provider you use)
AI_PROVIDER_ENDPOINT=https://api.example.com/v1
AI_PROVIDER_API_KEY=your_api_key_here
AI_PROVIDER_MODEL=your_model_name_here

# Image Storage
IMAGE_STORAGE_PATH=./uploads
